{
  "name": "everhook-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:worker": "tsx watch --env-file=.env src/workers/poller.ts",
    "mock:subscriber": "tsx scripts/mock-subscriber.ts",
    "bench": "tsx --env-file=.env scripts/bench.ts",
    "bench:publish": "tsx --env-file=.env scripts/bench.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.0",
    "ioredis": "^6.0.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
